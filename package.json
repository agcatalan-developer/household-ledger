{
  "name": "household-ledger",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "node server/dist/index.js",
    "migrate": "npm run migrate -w server",
    "seed:users": "npm run seed:users -w server",
    "typecheck": "tsc -p server/tsconfig.typecheck.json && tsc -p client/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project server --project client",
    "test:coverage": "vitest run --project server --coverage",
    "check": "npm run typecheck && npm run lint && npm run gates && npm run test && npm run test:coverage",
    "gates": "node scripts/gates.mjs",
    "e2e": "vitest run --project e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "argon2@0.41.1": true
  }
}

# /srv/household-ledger/.env   —   chmod 600, owned by ledger, NEVER in git
#
# After launch this file holds four values. SEED_A_* / SEED_B_* are removed once
# both users have changed their passwords in Settings (Phase 14) — they exist
# for exactly one run of `npm run seed:users`.

DATABASE_URL=mysql://ledger:CHANGE_ME@127.0.0.1:3306/household_ledger
JWT_SECRET=CHANGE_ME              # openssl rand -base64 48   (32+ chars or the server refuses to boot)
PORT=3000
NODE_ENV=production

# --- remove these two blocks after first login ---
SEED_A_EMAIL=you@example.com
SEED_A_PASSWORD=a-temporary-password
SEED_B_EMAIL=them@example.com
SEED_B_PASSWORD=another-temporary-password
